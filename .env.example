# ==============================================================================
# LEMEGETON DISCORD BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file documents the primary v3 bot and dashboard environment settings.
# Only variables consumed by the v3 TypeScript bot or Rust dashboard are documented here.
# Keep real credentials private and never commit a populated .env file.
#
# Format: VARIABLE_NAME=value (no spaces around =)
# Comments start with #
# ==============================================================================

# ==============================================================================
# CORE DISCORD CONFIGURATION (Required)
# ==============================================================================
# Discord bot authentication and primary identifiers
# Optional text channel for forwarding saved feedback submissions
BOT_FEEDBACK_CHANNEL_ID=

# Optional comma-separated Discord IDs allowed to moderate Global Archive entries across servers.
ARCHIVE_GLOBAL_MODERATOR_IDS=

DISCORD_TOKEN=
BOT_ID=
# Optional application ID override; CLIENT_ID is also accepted as a compatibility alias.
DISCORD_CLIENT_ID=
GUILD_ID=
ADMIN_DISCORD_ID=
# Required for /log, /moderators, /planned, /adminlogin and /convertlinks.
# These operator commands are registered only in this server and fail closed when this is unset.
BOT_MODERATOR_GUILD_ID=

# Bot log threshold: debug, info, warn or error.
LOG_LEVEL=info

# ANILIST API CONFIGURATION
# ==============================================================================
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_API_TIMEOUT=10

# ==============================================================================
# GAMING INTEGRATIONS
# ==============================================================================
# Steam API
STEAM_API_KEY=

# IGDB (Twitch) API for game cover lookups
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# MUSIC RELEASE TRACKING (optional)
# Spotify artist and album discovery via the Client Credentials flow.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 for YouTube Music channel/upload discovery.
YOUTUBE_API_KEY=
# Optional SoundCloud API client ID for artist name search; profile URLs and RSS remain available without it.
SOUNDCLOUD_CLIENT_ID=
# Automatic provider polling interval in minutes (default 10).
MUSIC_POLL_INTERVAL_MINUTES=10

# PRIVATE MEDIA OBJECT STORAGE (optional; Panels and Custom Role image originals)
# Keep this bucket private. The bot issues short-lived signed URLs for display.
# S3_ENDPOINT_URL is optional for AWS S3; set it for R2/MinIO/other S3-compatible stores.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_SIGNED_URL_TTL_SECONDS=900
ARCHIVE_UPLOAD_MAX_BYTES=20971520

# ==============================================================================
# TRANSLATION PROVIDERS (all optional)
# Fallback order: MADLAD -> DeepL -> NLLB -> LibreTranslate/Argos -> Google Cloud Translation.
# MADLAD/NLLB URLs must expose POST endpoints accepting JSON:
# { "text": "...", "source_language": "en", "target_language": "de" }
# and returning { "translated_text": "..." }. Model-serving services are deployed separately.
MADLAD_TRANSLATION_URL=
MADLAD_TRANSLATION_TOKEN=
# Match the endpoint to your DeepL API account:
# Free: https://api-free.deepl.com/v2/translate | Paid: https://api.deepl.com/v2/translate
# DeepL is enabled only when both its endpoint and API key are set.
DEEPL_TRANSLATION_URL=
DEEPL_API_KEY=
NLLB_TRANSLATION_URL=
NLLB_TRANSLATION_TOKEN=
# NLLB-200 weights are CC-BY-NC 4.0. Enable only for strictly non-commercial use,
# after reviewing the model licence and its production-use limitations.
NLLB_NONCOMMERCIAL_USE_CONFIRMED=false
# Full LibreTranslate endpoint URL, e.g. https://translate.example/translate.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Optional Google Cloud Translation Basic API key. Enable the API in a Google Cloud project first.
# Google Cloud Translation may incur usage charges; leave the key unset to disable this final provider.
GOOGLE_TRANSLATE_API_KEY=
# Timeout per provider attempt, in milliseconds (default 5000, maximum 15000).
TRANSLATION_TIMEOUT_MS=5000

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Preferred: use one connection string. DATABASE_URL takes precedence over POSTGRES_DSN and POSTGRES_URL.
DATABASE_URL=
# Optional connection-string aliases if your hosting provider supplies one of these names.
POSTGRES_DSN=
POSTGRES_URL=

# Alternatively, configure the individual PostgreSQL connection fields below.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Remote PostgreSQL hosts require TLS with certificate and hostname verification.
# Production always requires TLS. Only loopback development databases may use plaintext.
# Set POSTGRES_SSL=true for loopback TLS, or provide a trusted CA bundle here.
POSTGRES_SSL_CA_FILE=
POSTGRES_SSL=
POSTGRES_POOL_SIZE=5
# Compatibility fallback for POSTGRES_POOL_SIZE when the newer variable is unset.
DB_CONNECTION_POOL_SIZE=5

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Set to "production" to require PostgreSQL TLS and disable development-only Custom Roles previews
ENVIRONMENT=development

 
# ==============================================================================
# ==============================================================================
# WEB MANAGEMENT DASHBOARD (Optional)
# ==============================================================================
# Frontend: npm install --prefix web/frontend && npm run typecheck --prefix web/frontend && npm run build --prefix web/frontend
# Rust web service: cargo build --manifest-path web/backend/Cargo.toml --release
# Production: use HTTPS for DASHBOARD_PUBLIC_URL and DASHBOARD_REDIRECT_URI, then enable secure cookies.
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://localhost:8080/oauth/callback
# Set the exact origin users open in their browser (no trailing slash).
DASHBOARD_PUBLIC_URL=http://localhost:8080
DASHBOARD_HOST=127.0.0.1 # Loopback by default.
DASHBOARD_ALLOW_PUBLIC_BIND=false # Enable only for platform/container ingress or an explicitly protected deployment.
DASHBOARD_PORT=8080
DASHBOARD_COOKIE_SECURE=false # Local development only; production HTTPS requires true.
DASHBOARD_SESSION_TTL=28800
# Add comma-separated Discord IDs for bot-wide owner-only views (logs/integrations).
DASHBOARD_OWNER_IDS=
# Private shared secret shared only by Rust and the bot runtime; minimum 32 UTF-8 bytes.
# Generate with: openssl rand -hex 32
DASHBOARD_BRIDGE_SECRET=
DASHBOARD_ATLAS_BRIDGE_PORT=8093
DASHBOARD_BRIDGE_HOST=127.0.0.1
DASHBOARD_BRIDGE_PORT=8091
# Existing custom-role picker remains private and is reverse-proxied through the Rust service.
DASHBOARD_PICKER_HOST=127.0.0.1
DASHBOARD_PICKER_PORT=8092

# ==============================================================================
# MEDIA METADATA
# ==============================================================================
# TMDB API Read Access Token for /browse Movies and TV Shows.
# Create an API application in your TMDB account settings; keep the token private.
TMDB_BEARER_TOKEN=

# Optional Google Books API key for book metadata lookup.
GOOGLE_BOOKS_API_KEY=

# ==============================================================================
# CUSTOM ROLES (custom booster roles) - setup guide: docs/HANDOFF_NOTES.md
# ==============================================================================
# Each line: the default, then what it does. Leaving a setting out uses its default.

# --- Background checks ---
# Default 30 (minimum 1). Minutes between automatic checks of every custom role; one also runs at startup.
CUSTOM_ROLES_RECONCILE_MINUTES=30
# Default 10. Removing more than this many custom roles at once waits for an admin to confirm.
CUSTOM_ROLES_MASS_ARCHIVE_THRESHOLD=10

# --- Role icons ---
# Default 8388608 (8 MB, minimum 262144). Largest original image for a role icon (upload, link or
# the panel's Icon form). Originals are stored so icons can be re-cropped; Discord always gets a PNG under 256 KB.
CUSTOM_ROLES_ICON_SOURCE_MAX_BYTES=8388608

# --- Color picker web page (the Color picker button in /custom-role) ---
# Default true. Serves the picker on the private DASHBOARD_PICKER_HOST:DASHBOARD_PICKER_PORT listener behind the Rust dashboard proxy.
CUSTOM_ROLES_PICKER_ENABLED=true
# Must exactly match DASHBOARD_PUBLIC_URL (same browser-visible origin, no trailing slash). Must be https:// in production.
CUSTOM_ROLES_PUBLIC_URL=http://localhost:8080
# Default 3600 (1 hour, minimum 60). A link closes after this many seconds without use.
CUSTOM_ROLES_PICKER_IDLE_TTL=3600
# Default 10800 (3 hours). A link closes after this many seconds at the latest, however much it's used.
CUSTOM_ROLES_PICKER_MAX_TTL=10800
# Default false. true only behind a proxy that appends the visitor's address to X-Forwarded-For
# (Railway); the rightmost entry is used. When false the header is ignored completely.
CUSTOM_ROLES_TRUST_PROXY=false

# --- TEST SWITCHES: NEVER IN PRODUCTION ---
# Each one only works when ENVIRONMENT=development (also the default when ENVIRONMENT is unset!),
# and prints a loud warning at startup and in every custom roles log channel while it's on.
# Default false. NEVER IN PRODUCTION. Unlocks Gradient/Holographic on the picker page without Enhanced
# Role Styles (3 server boosts), to preview the design. Saving them is still refused.
CUSTOM_ROLES_DEBUG_PREVIEW_ENHANCED_COLORS=false
# Default false. NEVER IN PRODUCTION. Unlocks the picker's Role Icon tab without Role Icons (Boost
# Level 2), to test upload, link and crop. Setting the icon is still refused.
CUSTOM_ROLES_DEBUG_PREVIEW_ROLE_ICONS=false
