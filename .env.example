# ==============================================================================
# LEMEGETON DISCORD BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains all configuration variables for the Lemegeton bot.
# Keep this file secure and never commit it to version control!
#
# Format: VARIABLE_NAME=value (no spaces around =)
# Comments start with #
# ==============================================================================

# ==============================================================================
# CORE DISCORD CONFIGURATION (Required)
# ==============================================================================
# Discord bot authentication and primary identifiers
DISCORD_TOKEN=
BOT_ID=
GUILD_ID=
CHANNEL_ID=
ADMIN_DISCORD_ID=

# Role IDs for bot permissions and notifications
MOD_ROLE_ID=
BOT_UPDATE_ROLE_ID=

# ==============================================================================
# BOT MONITORING & NOTIFICATIONS
# ==============================================================================
# Discord webhook for bot status notifications (startup, shutdown, errors)
DISCORD_WEBHOOK_URL=

# Aura logging webhook (separate from main bot notifications)
AURA_WEBHOOK_URL=

# ==============================================================================
# BOT BEHAVIOR CONFIGURATION
# ==============================================================================
# Logging
LOG_MAX_SIZE=52428800

# Status Updates (seconds)
STATUS_UPDATE_INTERVAL=3600
TRENDING_REFRESH_INTERVAL=10800

# Development vs Production
COG_WATCH_INTERVAL_PROD=10
COG_WATCH_INTERVAL_DEV=2

# Cleanup Tasks (seconds)
USER_CLEANUP_INTERVAL=21600

# ==============================================================================
# ANILIST API CONFIGURATION
# ==============================================================================
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_API_TIMEOUT=10
DEFAULT_TRENDING_FALLBACK=AniList API ❤️

# ==============================================================================
# GAMING INTEGRATIONS
# ==============================================================================
# Steam API
STEAM_API_KEY=

# IGDB (Twitch) API for game cover lookups
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Twitch Streaming URL (displayed in bot status)
TWITCH_STREAMING_URL=https://www.twitch.tv/owobotplays

# HowLongToBeat Configuration
export HLTB_HTTP_PROXY="http://127.0.0.1:8080/"
export HLTB_USE_PLAYWRIGHT=1

# ==============================================================================
# AI/LLM CONFIGURATION
# ==============================================================================
# OpenAI API (recommendations, chat features)
OPENAI_API_KEY=

# OpenRouter API (primary AI provider)
OPENROUTER_API_KEY=

# Google Gemini API (alternative AI provider)
GEMINI_API_KEY=

# Ollama (local AI, optional)
OLLAMA_HOST=http://127.0.0.1:11434

# ==============================================================================
# GOOGLE APIS (Optional)
# ==============================================================================
# Google Cloud APIs (for various features)
YOUR_API_KEY=
PERSPECTIVE_API_KEY=your_perspective_key
GOOGLE_VISION_API_KEY=your_google_vision_key

# ==============================================================================
# THIRD-PARTY APIS
# ==============================================================================
# EZ API (miscellaneous features)
EZ_API=

# ==============================================================================
# API RESILIENCE CONFIGURATION
# ==============================================================================
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY=1.0

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_CONNECTION_POOL_SIZE=5
# DATABASE_PATH=data/database.db  # Uncomment to override default path

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Set to "production" or "development" to control cog watch interval
# ENVIRONMENT=production

 
# ==============================================================================
# WEB MANAGEMENT DASHBOARD (Optional; requires a Discord OAuth2 application)
# ==============================================================================
# OAuth2 client ID. Defaults to CLIENT_ID when omitted.
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
# Generate a long random value; do not reuse your Discord bot token.
DASHBOARD_SECRET_KEY=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Register this exact URL in your Discord application's OAuth2 redirect URLs.
DASHBOARD_REDIRECT_URI=http://localhost:8080/oauth/callback
# Set true when served over HTTPS.
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_SESSION_TTL=28800

# ==============================================================================
# LUNAR ROLES (custom booster roles)
# ==============================================================================
# Minutes between automatic reconcile runs (it also runs once at startup).
LUNAR_RECONCILE_MINUTES=30
# Removing more than this many custom roles at once needs an admin to confirm.
LUNAR_MASS_ARCHIVE_THRESHOLD=10
# TEST ONLY - never enable in production. Pretends the member list can't load so
# reconcile skips archiving. Only honoured when ENVIRONMENT=development.
LUNAR_DEBUG_FAIL_MEMBER_FETCH=false
# TEST ONLY - never enable in production. Unlocks Gradient/Holographic in the color picker
# page so their design can be checked on a server without Enhanced Role Colors. Saving
# them is still refused. Only honoured when ENVIRONMENT=development.
LUNAR_DEBUG_PREVIEW_ENHANCED_COLORS=false
# TEST ONLY - never enable in production. Unlocks the Role Icon tab of the color picker on a
# server without Role Icons (Boost Level 2) so upload, link and crop can be tested. Setting the
# icon is still refused. Only honoured when ENVIRONMENT=development.
LUNAR_DEBUG_PREVIEW_ROLE_ICONS=false
# Largest original image (bytes) for a role icon, by upload or link. Originals are stored as-is
# so icons can be re-cropped; the icon sent to Discord is always under 256 KB. Default 8 MB.
LUNAR_ICON_SOURCE_MAX_BYTES=8388608
# Web color picker (/lunar color-picker). Runs on DASHBOARD_HOST:DASHBOARD_PORT and works
# without the dashboard's OAuth settings.
LUNAR_PICKER_ENABLED=true
# Address members open, without a trailing slash. Local testing: http://localhost:8080.
# Production must be https:// (links aren't handed out over plain http in production).
LUNAR_PUBLIC_URL=http://localhost:8080
# A picker link closes after this many seconds without use (using the page resets it)...
LUNAR_PICKER_IDLE_TTL=3600
# ...and after this many seconds at the latest. A new link always replaces the old one.
LUNAR_PICKER_MAX_TTL=10800
# true only behind a proxy that appends the client address to X-Forwarded-For (Railway).
# Leave false locally: the header is then ignored completely.
LUNAR_TRUST_PROXY=false
