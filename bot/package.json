{
  "name": "lemegeton-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Lemegeton v3 TypeScript Discord bot runtime",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "deploy:commands": "node --env-file-if-exists=../.env dist/deploy-commands.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "typescript": "7.0.2"
  }
}
