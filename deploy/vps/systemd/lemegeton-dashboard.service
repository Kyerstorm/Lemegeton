[Unit]
Description=Lemegeton Rust web dashboard
After=network-online.target lemegeton-bot.service
Wants=network-online.target

[Service]
Type=simple
User=lemegeton-dashboard
Group=lemegeton-dashboard
SupplementaryGroups=lemegeton-read lemegeton-data
WorkingDirectory=/opt/lemegeton
StateDirectory=lemegeton-dashboard
StateDirectoryMode=0700
EnvironmentFile=/etc/lemegeton/dashboard.env
Environment=HOME=/nonexistent
Environment=LIBSQL_PATH=/opt/lemegeton/data/bot/lemegeton.db
Environment=DASHBOARD_SESSION_DB_PATH=/var/lib/lemegeton-dashboard/sessions.sqlite
ExecStart=/opt/lemegeton/target/release/lemegeton-dashboard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0007

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/lemegeton/data

[Install]
WantedBy=multi-user.target
