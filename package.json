{
  "name": "lemegeton-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Lemegeton v3 Discord bot runtime",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "npm run build:native && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env dist/bot.js",
    "deploy:commands": "node --env-file-if-exists=.env dist/src/deploy-commands.js",
    "stats": "node scripts/repo-stats.mjs --update-readme",
    "build:native": "node src/utility/database/build-native.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "sharp": "0.35.5",
    "@extractus/article-extractor": "^9.0.1",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "axios": "^1.21.1",
    "jsdom": "^26.1.0",
    "node-html-parser": "^9.0.7",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "playwright": "^1.65.1",
    "tough-cookie": "^6.1.0",
    "undici": "^7.30.2",
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "typescript": "7.0.2",
    "@types/jsdom": "^21.1.7",
    "node-gyp": "^12.1.0"
  }
}
