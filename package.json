{
  "name": "lemegeton-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Lemegeton v3 Discord bot runtime",
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env dist/bot.js",
    "deploy:commands": "node --env-file-if-exists=.env dist/Src/deploy-commands.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "discord.js": "14.27.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@types/pg": "^8.15.5",
    "typescript": "7.0.2"
  }
}
