{
  "name": "lemegeton-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Lemegeton v3 Discord bot runtime",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node --env-file-if-exists=.env dist/bot.js",
    "deploy:commands": "node --env-file-if-exists=.env dist/src/deploy-commands.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "discord.js": "14.27.0",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "@extractus/article-extractor": "^9.0.1",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "robots-parser": "^3.0.1",
    "axios": "^1.21.1",
    "jsdom": "^26.1.0",
    "node-html-parser": "^9.0.7",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "playwright": "^1.65.1",
    "tough-cookie": "^6.1.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "22.16.0",
    "@types/pg": "^8.15.5",
    "typescript": "7.0.2",
    "@types/jsdom": "^21.1.7"
  }
}
